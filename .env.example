# ============================================
# Configuración de Supabase (base de datos en la nube)
# Copia este archivo como ".env.local" y rellena los valores reales.
#
# IMPORTANTE (seguridad):
# - .env.local NO se sube a git (ya está en .gitignore).
# - Estas variables son SOLO de servidor (sin prefijo NEXT_PUBLIC_),
#   así nunca llegan al navegador del usuario.
# - El SERVICE_ROLE_KEY es una llave maestra: no la compartas ni la pongas
#   en código del cliente.
# - En Vercel: Project → Settings → Environment Variables → agrega las mismas
#   dos variables (entorno Production) y luego Redeploy.
# - En Supabase: Project Settings → Data API → ahí están Project URL y
#   la service_role key (Reveal).
# ============================================

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# ============================================
# Scraping (/api/scrape)
# - Los visitantes sin token pueden scrapear hasta SCRAPE_PUBLIC_MAX_PAGES
#   páginas por ejecución (por defecto 3).
# - Con la cabecera "Authorization: Bearer <SCRAPE_TOKEN>" se permite el
#   listado completo. Genera un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - Si SCRAPE_TOKEN no está definido, nadie obtiene acceso completo.
# ============================================

SCRAPE_TOKEN=
SCRAPE_PUBLIC_MAX_PAGES=3
